# Absolute path to an Obsidian-style Vault.
# When omitted, the app uses ../个人知识库.
PERSONAL_DASHBOARD_VAULT_ROOT=/absolute/path/to/your-vault

# For existing Obsidian/DBA libraries, include .raw, scripts and office text,
# exclude plugin internals, dependencies and credential files.
# PERSONAL_DASHBOARD_PROFILE=obsidian
# Read-only by default for the obsidian profile (including AI workflow APIs).
# PERSONAL_DASHBOARD_READ_ONLY=true

# Optional knowledge assistant. Existing write/execute APIs stay disabled.
# Only a user-reviewed, explicitly confirmed new Markdown may be created.
# WORKBENCH_KNOWLEDGE_CHAT=true
# WORKBENCH_KNOWLEDGE_CREATE=true
# Explicit opt-in to reuse only gateway credentials/model from local Claude settings.
# WORKBENCH_KNOWLEDGE_USE_CLAUDE_SETTINGS=true
# Or configure an Anthropic Messages-compatible gateway explicitly:
# WORKBENCH_KNOWLEDGE_BASE_URL=https://your-gateway.example
# WORKBENCH_KNOWLEDGE_MODEL=your-model-name
# WORKBENCH_KNOWLEDGE_API_KEY=

# Optional read-only GitHub discovery credential. Use only read-only permissions.
# Store locally in ignored Workbench/.env; credentials are excluded from backups.
# WORKBENCH_GITHUB_TOKEN=

# Optional. Keep the development server loopback-only unless you add auth.
# PERSONAL_DASHBOARD_HOST=127.0.0.1

# Optional local branding. Keep personal names in the ignored .env file.
# VITE_WORKBENCH_BRAND=Demo · AI Dashboard
# VITE_WORKBENCH_TITLE=Demo · AI Dashboard
